# URL pública donde corre el bot, usada para construir los enlaces de firma
BASE_URL=http://localhost:8000

# Base de datos (SQLite por defecto, cambia a Postgres en producción)
DATABASE_URL=sqlite:///./data/app.db

# Twilio (WhatsApp Business API) - deja vacío para correr en modo simulado (solo logs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP) - deja vacío para correr en modo simulado (solo logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=consentimientos@tuestetica.com

# Login del panel /admin (donde se ven datos de pacientes). Si lo dejas vacío,
# se genera una contraseña aleatoria en cada arranque y se imprime en el log.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secreto compartido para autenticar POST /webhooks/flowww (header X-Webhook-Secret)
WEBHOOK_SECRET=

# Con cuántas horas de antelación se manda el recordatorio de cita
REMINDER_LEAD_HOURS=24

# Bandeja donde llegan (o se reenvían) los correos de confirmación de flowww.
# Deja vacío para desactivar el lector de correo.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
FLOWWW_SENDER_EMAIL=noreply@flowww.com
